# syntax=docker/dockerfile:1.7
# Canonical hardened image for supported Linux Docker hosts.

ARG PNPM_VERSION=10.18.3
ARG GH_VERSION=2.103.0
ARG GH_LINUX_AMD64_SHA256=fdd768eb70f6409f80fcfa9f3a1c0adf0fc98d827ab3ce0bed2ac22762c5d786
ARG PILLOW_VERSION=13.0.0
ARG SEVENZIP_VERSION=26.05
ARG SEVENZIP_LINUX_X64_SHA256=22cf82fcc6eb7474f1d5bb4f02c0f8ebd573a718089d6833dc30f8350a3b232e

# ── Stage 1: Frontend build ──────────────────────────────────────────
FROM node:22-bookworm-slim AS frontend-builder
ARG PNPM_VERSION
RUN corepack enable && corepack prepare "pnpm@${PNPM_VERSION}" --activate
WORKDIR /app/web
COPY web/package.json web/pnpm-lock.yaml* web/pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm-web,target=/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile --store-dir=/pnpm/store
COPY web/ ./
RUN pnpm build

# ── Stage 2: Backend build ───────────────────────────────────────────
FROM node:22-bookworm-slim AS backend-builder
ARG PNPM_VERSION
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++
RUN corepack enable && corepack prepare "pnpm@${PNPM_VERSION}" --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml* ./
RUN --mount=type=cache,id=pnpm-root,target=/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile --store-dir=/pnpm/store
COPY src/ ./src/
COPY tsconfig*.json nest-cli.json ./
# Schema types are generated by the `@openai/codex` development dependency
# installed above. This build-only package is discarded with the builder stage;
# the runtime CLI is installed separately from the administration interface.
RUN pnpm build

# Rebuild official Debian security-fixed OpenSSH sources against Trixie libraries.
# Build dependencies and the server used for tests never enter the final image.
FROM debian:trixie-slim AS openssh-builder
ENV DEBIAN_FRONTEND=noninteractive
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl build-essential dpkg-dev debhelper dh-exec dh-runit \
    dh-sequence-installsysusers libaudit-dev libcrypt-dev libedit-dev libfido2-dev \
    libkrb5-dev libpam0g-dev libselinux1-dev libssl-dev libwrap0-dev libwtmpdb-dev \
    pkgconf zlib1g-dev autoconf automake libtool openssl procps
WORKDIR /build
COPY scripts/build-openssh-backport.sh /tmp/build-openssh-backport.sh
RUN bash /tmp/build-openssh-backport.sh

# Backport maintained 2.9.14 security fixes without replacing LibreOffice's ABI.
FROM debian:trixie-slim AS libxml2-builder
ENV DEBIAN_FRONTEND=noninteractive
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl build-essential dpkg-dev debhelper quilt autoconf automake \
    libtool liblzma-dev pkg-config rename zlib1g-dev python3
WORKDIR /build
COPY security/libxml2-patches/ /reviewed-patches/
COPY scripts/build-libxml2-backport.sh scripts/smoke-test-libxml2.c /tmp/
RUN bash /tmp/build-libxml2-backport.sh

# ── Stage 3: Shared runtime system ───────────────────────────────────
FROM debian:trixie-slim AS runtime-base

ARG GH_VERSION
ARG GH_LINUX_AMD64_SHA256
ARG PILLOW_VERSION
ARG SEVENZIP_VERSION
ARG SEVENZIP_LINUX_X64_SHA256

ENV DEBIAN_FRONTEND=noninteractive
ENV HOME=/home/codex
ENV MISE_YES=1
ENV NODE_ENV=production
ENV PATH="/opt/office-venv/bin:/home/codex/.local/bin:/home/codex/.local/share/mise/shims:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin"

RUN mkdir -p /home/codex

# System dependencies
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    bash \
    tar \
    gzip \
    ripgrep \
    fd-find \
    jq \
    less \
    file \
    procps \
    libreoffice-writer \
    libreoffice-calc \
    libreoffice-impress \
    fonts-dejavu \
    fonts-liberation \
    bubblewrap \
    build-essential \
    pkg-config \
    python3 \
    xz-utils \
    zstd

# Replace the actual Debian libxml2 package; retain the established SONAME and
# exported-symbol contract. Development headers remain in the Office builder.
COPY --from=libxml2-builder /out/ /tmp/libxml2-backport/
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
 && apt-get install -y --no-install-recommends /tmp/libxml2-backport/libxml2_*_amd64.deb \
 && mkdir -p /usr/local/share/libxml2-backport \
 && cp /tmp/libxml2-backport/*.dsc /tmp/libxml2-backport/*.json /usr/local/share/libxml2-backport/ \
 && rm -rf /tmp/libxml2-backport

# Install real rebuilt Debian packages, replacing the old client rather than
# shadowing it in PATH. GSSAPI preserves the capabilities of Trixie's client.
COPY --from=openssh-builder /out/ /tmp/openssh-backport/
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
 && apt-get install -y --no-install-recommends systemd-standalone-sysusers /tmp/openssh-backport/*.deb \
 && mkdir -p /usr/local/share/openssh-backport \
 && cp /tmp/openssh-backport/*.dsc /usr/local/share/openssh-backport/ \
 && rm -rf /tmp/openssh-backport \
 && ssh -V 2>&1 | grep -F 'OpenSSH_10.6p1'

# Use one reviewed upstream build for both archive listing and streaming.
# Keep the compatibility command names, without retaining Debian's old binaries.
COPY scripts/install-sevenzip.sh /tmp/install-sevenzip.sh
RUN bash /tmp/install-sevenzip.sh "${SEVENZIP_VERSION}" "${SEVENZIP_LINUX_X64_SHA256}" /opt/7zip \
 && rm /tmp/install-sevenzip.sh \
 && for command in 7z 7za 7zr; do ln -s /opt/7zip/7zz "/usr/local/bin/${command}"; done

# The upstream release includes fixes in both gh and its compiled Go dependencies.
# Verify its published digest before exposing the immutable binary in PATH.
RUN curl --fail --silent --show-error --location \
      "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_amd64.tar.gz" \
      --output /tmp/gh.tar.gz \
 && echo "${GH_LINUX_AMD64_SHA256}  /tmp/gh.tar.gz" | sha256sum --check --strict \
 && tar -xzf /tmp/gh.tar.gz \
      --strip-components=2 \
      --directory=/usr/local/bin \
      "gh_${GH_VERSION}_linux_amd64/bin/gh" \
 && rm /tmp/gh.tar.gz \
 && gh version | grep -F "gh version ${GH_VERSION}"

# Python headers and packaging tools are needed while assembling the managed
# Python runtimes, but not by the published image. Keeping them in this shared
# builder prevents every development header from becoming a runtime layer.
FROM runtime-base AS python-builder-base

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    python3-venv \
    libssl-dev \
    zlib1g-dev \
    libbz2-dev \
    libreadline-dev \
    libsqlite3-dev \
    libffi-dev \
    liblzma-dev \
    tk-dev \
    uuid-dev

# Keep the Office Python stack together in one isolated runtime. Installing
# these packages from Debian pulled in python3-pil 11, which is affected by two
# image-decoder vulnerabilities. Direct and transitive pins keep rebuilds stable.
FROM python-builder-base AS office-builder

COPY --from=libxml2-builder /out/libxml2-dev_*_amd64.deb /tmp/libxml2-dev.deb
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
 && apt-get install -y --no-install-recommends python3-dev libxslt1-dev /tmp/libxml2-dev.deb \
 && rm /tmp/libxml2-dev.deb

RUN python3 -m venv /opt/office-venv \
 && /opt/office-venv/bin/pip install --no-cache-dir --no-binary=lxml \
      "Pillow==${PILLOW_VERSION}" \
      "XlsxWriter==3.2.9" \
      "charset-normalizer==3.5.2" \
      "et-xmlfile==2.0.0" \
      "lxml==6.1.3" \
      "openpyxl==3.1.5" \
      "pypdf==6.21.2" \
      "python-docx==1.2.0" \
      "python-pptx==1.0.2" \
      "reportlab==5.0.1" \
      "typing_extensions==4.16.0" \
 && /opt/office-venv/bin/python -c \
      "from PIL import Image; from lxml import etree; import docx, openpyxl, pypdf, pptx, reportlab; assert etree.LIBXML_VERSION == (2, 9, 14); assert Image.__version__ == '${PILLOW_VERSION}'"

RUN command -v 7za >/dev/null

# ── Stage 4: Root toolchain seed ─────────────────────────────────────
# Build the user toolchain outside the final image. The final image receives
# only the compressed seed, avoiding a second copy of the same /home/codex tree in
# its immutable layers.
FROM python-builder-base AS toolchain-builder

# Install a reviewed mise installer whose digest is fixed in this Dockerfile.
ARG MISE_VERSION=2026.10.15
ARG MISE_INSTALLER_SHA256=79db94aec4c40bfa1ff8d696621c0f5f96e2282b6675fdb71d834cf4ab4a70d0
RUN curl --fail --silent --show-error --location \
      "https://github.com/jdx/mise/releases/download/v${MISE_VERSION}/install.sh" \
      --output /tmp/mise-install.sh \
 && echo "${MISE_INSTALLER_SHA256}  /tmp/mise-install.sh" | sha256sum --check --strict \
 && MISE_VERSION="${MISE_VERSION}" sh /tmp/mise-install.sh \
 && rm /tmp/mise-install.sh

RUN grep -q 'mise activate bash' /home/codex/.bashrc 2>/dev/null || \
    printf '\n# mise\nexport PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"\neval "$(mise activate bash)"\n' >> /home/codex/.bashrc

RUN --mount=type=cache,id=mise-downloads,target=/home/codex/.cache/mise,sharing=locked \
    mise use -g node@22.23.3 uv@0.13.3 python@3.14.8

# Libraries used by the persistent Office skill.
RUN node --version \
 && npm --version \
 && uv --version \
 && python --version \
 && mise --version

# Install global MCP utilities. Codex itself is installed explicitly from the
# administration UI and stored outside the immutable image.
RUN --mount=type=cache,id=npm-toolchain,target=/home/codex/.npm,sharing=locked \
    npm install -g \
    mcp-safe-proxy \
    mcp-remote

# Enable the pinned pnpm release for production dependency installation
ARG PNPM_VERSION
RUN corepack enable && corepack prepare "pnpm@${PNPM_VERSION}" --activate

# Caches are installation by-products, not part of the user toolchain.
RUN mkdir -p /home/codex/.codex /opt \
 && rm -rf /home/codex/.cache /home/codex/.npm \
 && tar -C /home/codex --zstd -cf /opt/codex-home-seed.tar.zst .

# ── Stage 5: Production Node dependencies ────────────────────────────
FROM toolchain-builder AS app-deps-builder
WORKDIR /app

# Install production dependencies; lifecycle scripts build native addons
COPY package.json pnpm-lock.yaml* ./
RUN --mount=type=cache,id=pnpm-root,target=/pnpm/store,sharing=locked \
    --mount=type=cache,id=node-gyp,target=/home/codex/.cache/node-gyp,sharing=locked \
    corepack pnpm install --frozen-lockfile --prod --store-dir=/pnpm/store
# Installation scripts above build native addons when no compatible prebuild is
# available. Loading them here turns a missing or incompatible binary into a
# build failure instead of publishing a broken image.
RUN node -e "require('node-pty'); const Database = require('better-sqlite3'); const db = new Database(':memory:'); db.close()"

# Test-only target, run on an internal Docker network without published ports.
FROM runtime-base AS ssh-test-server
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpam0g libwrap0 libwtmpdb0 libaudit1 \
 && mkdir -p /run/sshd /usr/lib/openssh \
 && passwd -d root \
 && useradd --system --gid nogroup --home-dir /run/sshd --shell /usr/sbin/nologin sshd
COPY --from=openssh-builder /build/openssh/debian/build-deb/sshd /usr/sbin/sshd
COPY --from=openssh-builder /build/openssh/debian/build-deb/sshd-auth /usr/lib/openssh/sshd-auth
COPY --from=openssh-builder /build/openssh/debian/build-deb/sshd-session /usr/lib/openssh/sshd-session
CMD ["/bin/bash", "-euc", "git init --bare /tmp/remote.git && exec /usr/sbin/sshd -D -e -f /fixtures/sshd_config"]

# ── Stage 6: Runtime ─────────────────────────────────────────────────
FROM runtime-base AS runtime

ARG MERGERON_VERSION=0.1.0
ARG MERGERON_REVISION=unknown
ARG MERGERON_BUILD_DATE=unknown
ARG MERGERON_RELEASE_CHANNEL=edge

LABEL org.opencontainers.image.title="Mergeron" \
      org.opencontainers.image.description="Plateforme collaborative auto-hébergée de gestion de projets et d'agents" \
      org.opencontainers.image.source="https://github.com/maxhugit/mergeron" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later" \
      org.opencontainers.image.version="${MERGERON_VERSION}" \
      org.opencontainers.image.revision="${MERGERON_REVISION}" \
      org.opencontainers.image.created="${MERGERON_BUILD_DATE}"

ENV MERGERON_VERSION="${MERGERON_VERSION}" \
    MERGERON_REVISION="${MERGERON_REVISION}" \
    MERGERON_BUILD_DATE="${MERGERON_BUILD_DATE}" \
    MERGERON_RELEASE_CHANNEL="${MERGERON_RELEASE_CHANNEL}"

# runtime-base sets HOME before installing system packages. Some installers may
# leave build-only dotfiles there, which makes the entrypoint mistake a brand-new
# container home for an existing persistent volume. The final runtime image must
# start with an empty home so the toolchain seed can be restored deterministically.
RUN groupadd --gid 11002 codex \
 && useradd --uid 11002 --gid 11002 --home-dir /home/codex --shell /bin/bash codex \
 && find /home/codex -mindepth 1 -delete \
 && mkdir -p /home/codex /workspaces /app/logs \
 && chown -R 11002:11002 /home/codex /workspaces /app/logs \
 && ! find /home/codex -mindepth 1 -maxdepth 1 -print -quit | grep -q .

WORKDIR /app

RUN jq -n \
      --arg version "${MERGERON_VERSION}" \
      --arg revision "${MERGERON_REVISION}" \
      --arg builtAt "${MERGERON_BUILD_DATE}" \
      --arg channel "${MERGERON_RELEASE_CHANNEL}" \
      '{version: $version, revision: $revision, builtAt: $builtAt, channel: $channel}' \
      > /app/build-info.json

# The toolchain exists only once in the final image and is restored into a
# mounted /home/codex on first start.
COPY --from=toolchain-builder /opt/codex-home-seed.tar.zst /opt/codex-home-seed.tar.zst
COPY --from=office-builder /opt/office-venv /opt/office-venv
COPY --from=app-deps-builder /app/node_modules ./node_modules/
COPY package.json pnpm-lock.yaml* ./

# Copy built assets and migrations
COPY --from=backend-builder /app/dist ./dist/
COPY --from=frontend-builder /app/public ./public/
COPY drizzle/ ./drizzle/
COPY scripts/provision-person.cjs ./scripts/provision-person.cjs
COPY scripts/codex-cli-dispatch.sh /usr/local/bin/codex-cli-dispatch
COPY skills/office-files/ /opt/codex-skills/office-files/

RUN chmod +x /usr/local/bin/codex-cli-dispatch

# ── Entrypoint ───────────────────────────────────────────────────────
RUN cat > /usr/local/bin/entrypoint.sh <<'ENTRYPOINT_EOF'
#!/usr/bin/env bash
set -euo pipefail

ROOT_SEED="/opt/codex-home-seed.tar.zst"
ROOT_MARKER="/home/codex/.codex-webui-initialized"

is_root_seedable() {
  # Debian already ships standard shell startup files in /home/codex. A root that
  # contains only those files is still fresh and should receive the seed.
  ! find /home/codex -mindepth 1 -maxdepth 1 \
    ! -name '.profile' \
    ! -name '.bashrc' \
    ! -name '.bash_logout' \
    -print -quit | grep -q .
}

# ── Phase 1: Root seed restore ──────────────────────────────────────
restore_missing_seed() {
  for seed_path in .local .local/bin .local/share .local/share/mise .local/state .config .config/mise .codex; do
    if [ -L "/home/codex/${seed_path}" ]; then
      echo "[entrypoint] Refusing seed restore through symlink: ${seed_path}" >&2
      exit 1
    fi
  done
  tar -C /home/codex --zstd --skip-old-files -xf "${ROOT_SEED}"
  if [ ! -e "${ROOT_MARKER}" ]; then touch "${ROOT_MARKER}"; fi
}

if is_root_seedable; then
  echo "[entrypoint] /home/codex is fresh, restoring seed data..."
  restore_missing_seed
elif [ ! -e "${ROOT_MARKER}" ] || ! command -v node >/dev/null 2>&1; then
  echo "[entrypoint] /home/codex has data; restoring missing runtime files without replacing existing files."
  restore_missing_seed
else
  echo "[entrypoint] /home/codex already initialized."
fi

# Stable commands dispatch to the selected persistent release, or to a legacy
# installation while an existing deployment is being migrated.
mkdir -p /home/codex/.local/bin
for tool in codex apply_patch applypatch codex-execve-wrapper codex-linux-sandbox; do
  ln -sfn /usr/local/bin/codex-cli-dispatch "/home/codex/.local/bin/${tool}"
done

# Ensure directories exist (in case volume is pre-populated but partial)
mkdir -p /home/codex/.codex /workspaces /app/logs

# Skills live in the persistent home volume. Refresh the image-managed Office
# skill on every start so image updates also update its instructions.
mkdir -p /home/codex/.codex/skills
rm -rf /home/codex/.codex/skills/office-files
cp -a /opt/codex-skills/office-files /home/codex/.codex/skills/office-files

exec "$@"
ENTRYPOINT_EOF

RUN chmod +x /usr/local/bin/entrypoint.sh

USER 11002:11002

EXPOSE 8172

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -sf -H "Authorization: Bearer ${WEBUI_API_KEY}" http://localhost:8172/api/status || exit 1

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["node", "/app/dist/main.js"]
