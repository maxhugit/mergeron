{
  "schemaVersion": 1,
  "stack": "mergeron",
  "mode": "install",
  "networks": [
    { "id": "isolated", "name": "mergeron-isolated", "internal": true },
    { "id": "external", "name": "mergeron-external", "internal": false },
    {
      "id": "admin",
      "name": "mergeron-admin",
      "internal": false,
      "subnetFromConfiguration": true
    },
    {
      "id": "proxy",
      "name": "mergeron-proxy",
      "external": true
    }
  ],
  "components": [
    {
      "id": "application",
      "displayName": "Mergeron",
      "canonicalName": "mergeron-ui",
      "legacyNames": ["mergeron", "codex-webui"],
      "allowedImageRepositories": [
        "ghcr.io/maxhugit/mergeron",
        "ghcr.io/maxhugit/codex-webui-unraid"
      ],
      "requiredNetworks": ["mergeron-isolated", "mergeron-admin"],
      "protectedMounts": [
        {
          "target": "/home/codex",
          "purpose": "configuration, conversations and SQLite database"
        },
        {
          "target": "/workspaces",
          "purpose": "project workspaces"
        }
      ]
    },
    {
      "id": "ingress",
      "displayName": "Mergeron Ingress",
      "canonicalName": "mergeron-ingress",
      "legacyNames": ["codex-web-ingress"],
      "allowedImageRepositories": ["nginx"],
      "requiredNetworks": ["mergeron-isolated", "mergeron-proxy"],
      "protectedMounts": []
    },
    {
      "id": "egress",
      "displayName": "Mergeron Squid",
      "canonicalName": "mergeron-squid",
      "legacyNames": ["codex-web-squid"],
      "allowedImageRepositories": ["ubuntu/squid"],
      "requiredNetworks": ["mergeron-isolated", "mergeron-external"],
      "protectedMounts": []
    }
  ]
}
