{
  "name": "mergeron",
  "version": "0.4.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "ensure:codex-schema": "test -f src/codex/codex-schema/index.ts || pnpm codex:schema",
    "build": "pnpm ensure:codex-schema && nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "pnpm ensure:codex-schema && nest start",
    "start:dev": "pnpm ensure:codex-schema && nest start --watch",
    "start:debug": "pnpm ensure:codex-schema && nest start --debug --watch",
    "start:prod": "node dist/main",
    "generate:api": "pnpm --dir web generate:api",
    "lint": "pnpm ensure:codex-schema && eslint \"{src,apps,libs}/**/*.ts\" \"codex_probe/**/*.ts\" --fix && cd web && pnpm lint",
    "test": "pnpm ensure:codex-schema && vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest run --inspect-brk --no-file-parallelism",
    "check:release": "node scripts/release-version.mjs",
    "test:release": "node --test scripts/release-version.test.mjs",
    "codex:schema": "codex app-server generate-ts --out src/codex/codex-schema",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "codex:catalog": "codex debug models --bundled > docs/upstream/model-catalog-0.153.2.json",
    "probe": "ts-node --project codex_probe/tsconfig.json codex_probe/index.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/platform-socket.io": "^11.2.7",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/websockets": "^11.2.7",
    "@node-rs/argon2": "^2.2.2",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "better-sqlite3": "^12.10.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.7",
    "jsonwebtoken": "^9.0.2",
    "nestjs-pino": "^4.5.0",
    "node-pty": "^1.1.0",
    "openid-client": "^6.8.8",
    "pino-http": "^10.5.0",
    "pino-roll": "^4.0.0",
    "playwright-core": "1.64.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "tar-stream": "^3.1.7",
    "toml-eslint-parser": "1.0.3",
    "unrar-async": "^3.1.0",
    "yauzl": "^3.2.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.7",
    "@openai/codex": "0.153.2",
    "@swc/core": "^1.16.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/tar-stream": "^3.1.4",
    "@types/yauzl": "^2.10.3",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@scarf/scarf",
      "@swc/core",
      "better-sqlite3",
      "esbuild",
      "node-pty",
      "unrs-resolver"
    ],
    "overrides": {
      "fastify": "5.12.7",
      "proxy-addr": "2.0.8",
      "fast-uri@3": "3.1.7",
      "brace-expansion@5": "5.0.11",
      "js-yaml@4": "4.3.2",
      "engine.io@6": "6.6.10",
      "socket.io-parser@4": "4.2.7",
      "ws@8": "8.21.0",
      "@fastify/busboy@3": "3.2.4",
      "body-parser": "2.4.0",
      "multer": "2.5.0"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@nestjs/serve-static>@fastify/static": "^10.1.2"
      }
    }
  },
  "packageManager": "pnpm@10.18.3"
}
