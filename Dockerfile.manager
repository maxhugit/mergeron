# syntax=docker/dockerfile:1.7

# Native build and BPF regressions are cached independently of Manager code.
FROM rust:1.99.1-trixie@sha256:09027f873d45b8ecd1dc86f1fa13b7a62b875c961f017a0e331267b350430137 AS codex-runtime-builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git clang cmake pkg-config libssl-dev libcap-dev protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*
ENV CARGO_BUILD_JOBS=4 CARGO_PROFILE_RELEASE_LTO=false \
    CARGO_PROFILE_RELEASE_DEBUG=0 CARGO_PROFILE_RELEASE_STRIP=symbols \
    STABLE_GIT_COMMIT=6aaac694803004a63c6f393d153c96d22521a6b9
COPY security/codex-netlink/ /reviewed/
COPY scripts/build-codex-runtime.sh /build-runtime.sh
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/build/codex/codex-rs/target \
    bash /build-runtime.sh

FROM node:22-bookworm-slim AS codex-runtime-files
RUN npm install --prefix /assets @openai/codex@0.164.0 --ignore-scripts --no-audit --no-fund --registry=https://registry.npmjs.org
RUN mkdir -p /bundle/node_modules/@openai \
    && cp -a /assets/node_modules/@openai/codex-linux-x64 /bundle/node_modules/@openai/
COPY --from=codex-runtime-builder --chmod=555 /out/codex /bundle/node_modules/@openai/codex-linux-x64/vendor/x86_64-unknown-linux-musl/bin/codex
COPY --from=codex-runtime-builder /out/route-query.patch /reviewed.patch
COPY runtime/managed-cli.cjs /runtime/managed-cli.cjs
COPY scripts/package-codex-runtime.cjs /scripts/package-codex-runtime.cjs
RUN node /scripts/package-codex-runtime.cjs /bundle /reviewed.patch

FROM node:22-bookworm-slim AS manager-files

WORKDIR /opt/mergeron-manager
COPY manager/package.json manager/stack-manifest.json ./
COPY manager/src ./src
COPY runtime/preview-profile.cjs runtime/preview-archive.cjs /opt/runtime/
COPY deployment/browser/public-proxy.mjs /opt/deployment/browser/public-proxy.mjs
COPY runtime/managed-cli.cjs /opt/runtime/managed-cli.cjs
COPY --from=codex-runtime-files /bundle/ ./codex-runtime/
COPY deployment/config/seccomp-bwrap.json /opt/mergeron-manager/seccomp-bwrap.json
COPY deployment/config/nginx.conf.template deployment/config/nginx.native.conf.template deployment/config/squid.conf /opt/mergeron-manager/default-config/

RUN mkdir -p /runtime/run/mergeron-manager /runtime/var/lib/mergeron-manager \
 && chmod 0750 /runtime/run/mergeron-manager \
 && chmod 0700 /runtime/var/lib/mergeron-manager

# Keep npm and the build distribution out of the privileged final image.
FROM gcr.io/distroless/nodejs22-debian13@sha256:f643bc05bdcf5a8d98442e8a2a5c7a3a4c3a0e3bc4cdc5f10557d47f1ddd5812

ARG MERGERON_VERSION=0.1.0
ARG MERGERON_REVISION=unknown
ARG MERGERON_BUILD_DATE=unknown
ARG MERGERON_RELEASE_CHANNEL=edge

LABEL org.opencontainers.image.title="Mergeron Manager" \
      io.mergeron.codex-runtime="0.164.0-mergeron.1" \
      org.opencontainers.image.description="Gestionnaire local de la pile Mergeron" \
      org.opencontainers.image.source="https://github.com/maxhugit/mergeron" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later" \
      org.opencontainers.image.version="${MERGERON_VERSION}" \
      org.opencontainers.image.revision="${MERGERON_REVISION}" \
      org.opencontainers.image.created="${MERGERON_BUILD_DATE}"

ENV NODE_ENV=production \
    MERGERON_MANAGER_SOCKET=/run/mergeron-manager/manager.sock \
    MERGERON_MANAGER_SOCKET_GID=11002 \
    MERGERON_MANAGER_POLL_MS=20000 \
    MERGERON_DOCKER_SOCKET=/var/run/docker.sock \
    MERGERON_MANAGER_ADOPTION_PATH=/var/lib/mergeron-manager/adoption.json \
    MERGERON_STACK_PREFIX=mergeron \
    MERGERON_STACK_ENVIRONMENT=production \
    MERGERON_INSTALL_ENABLED=false \
    MERGERON_MANAGER_HOST_STATE=/host-state

WORKDIR /opt/mergeron-manager
COPY --from=manager-files --chown=0:0 /opt/mergeron-manager ./
COPY --from=manager-files --chown=0:0 /opt/runtime /opt/runtime
COPY --from=manager-files --chown=0:0 /opt/deployment /opt/deployment
COPY --from=manager-files --chown=0:0 /runtime/ /

VOLUME ["/run/mergeron-manager", "/var/lib/mergeron-manager"]
HEALTHCHECK --interval=20s --timeout=3s --retries=3 --start-period=10s \
  CMD ["/nodejs/bin/node", "src/healthcheck.mjs"]

USER 0
ENTRYPOINT ["/nodejs/bin/node", "src/server.mjs"]
