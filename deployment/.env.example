# Chemins absolus sur l’hôte Docker.
DEPLOY_ROOT=/srv/mergeron
STATE_ROOT=/srv/mergeron/state
MERGERON_APPDATA_ROOT=/srv/mergeron/state/appdata
MERGERON_STACK_PREFIX=mergeron
MERGERON_STACK_ENVIRONMENT=production
MERGERON_ADMIN_SUBNET=172.30.44.0/28
MERGERON_INSTALL_ENABLED=false
# Activer seulement après installation du navigateur isolé optionnel (Manager 0.5.1+).
MERGERON_MANAGE_BROWSER=false
MERGERON_PROXY_NETWORK=mergeron-proxy
# Mode standard : compte/mot de passe actif ; OIDC désactivé jusqu’à activation.
# L’adaptateur historique Authentik reste disponible sur choix explicite.
MERGERON_AUTH_MODE=native
# Compose uniquement : doit correspondre au mode choisi ci-dessus.
MERGERON_NGINX_TEMPLATE=nginx.native.conf.template

# Images. Pour une restauration reproductible, remplacer latest par un tag sha-...
MERGERON_APP_IMAGE=ghcr.io/maxhugit/mergeron:latest
MERGERON_MANAGER_IMAGE=ghcr.io/maxhugit/mergeron-manager:edge
MERGERON_INGRESS_IMAGE=nginx:stable
MERGERON_EGRESS_IMAGE=ubuntu/squid:latest

# URL publique et icône de la pile
MERGERON_WEBUI_URL=https://mergeron.example.com
MERGERON_ICON_URL=https://raw.githubusercontent.com/maxhugit/mergeron/main/web/public/pwa-icon-192.png
