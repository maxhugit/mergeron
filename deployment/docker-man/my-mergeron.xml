<?xml version="1.0"?>
<Container version="2">
  <Name>mergeron-ui</Name>
  <Repository>ghcr.io/maxhugit/mergeron:latest</Repository>
  <Registry>https://github.com/maxhugit/mergeron/pkgs/container/mergeron</Registry>
  <Network>mergeron-isolated</Network>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/maxhugit/mergeron/issues</Support>
  <Project>https://github.com/maxhugit/mergeron</Project>
  <Overview>Application Mergeron. Le backend n'expose aucun port directement et sort sur Internet uniquement par le proxy Squid.</Overview>
  <Category>Productivity: Tools:</Category>
  <WebUI>https://mergeron.example.com</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/maxhugit/mergeron/main/deployment/docker-man/my-mergeron.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/maxhugit/mergeron/main/web/public/pwa-icon-192.png</Icon>
  <ExtraParams>--network-alias=mergeron-ui --network-alias=mergeron --init --user 11002:11002 --group-add 11001 --workdir /app --entrypoint /bin/sh --read-only --tmpfs /tmp:rw,nosuid,nodev,size=512m,mode=1777 --cap-drop ALL --security-opt no-new-privileges:true --security-opt seccomp=/mnt/user/appdata/mergeron/config/seccomp-bwrap.json --security-opt systempaths=unconfined --pids-limit 1024 --memory 8g --cpus 3.5 --stop-timeout 1800 --health-cmd "/bin/sh /opt/codex/start-webui.sh healthcheck &gt;/dev/null" --health-interval 20s --health-timeout 5s --health-retries 8 --health-start-period 90s --log-opt max-size=20m --log-opt max-file=5</ExtraParams>
  <PostArgs>/opt/codex/start-webui.sh</PostArgs>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires>Le réconciliateur réseau doit être installé. Les réseaux mergeron-admin et mergeron-isolated ainsi que mergeron-squid doivent être présents.</Requires>
  <Config Name="État Mergeron" Target="/home/codex" Default="/mnt/user/appdata/mergeron/state/home" Mode="rw" Description="Conversations, configuration, OAuth, MCP et base SQLite." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/mergeron/state/home</Config>
  <Config Name="Espaces de travail" Target="/workspaces" Default="/mnt/user/appdata/mergeron/state/workspace" Mode="rw" Description="Fichiers des projets Mergeron." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/mergeron/state/workspace</Config>
  <Config Name="Appdata Unraid" Target="/appdata" Default="/mnt/user/appdata" Mode="rw" Description="Accès aux données des applications Unraid." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata</Config>
  <Config Name="Journaux" Target="/app/logs" Default="/mnt/user/appdata/mergeron/state/logs" Mode="rw" Description="Journaux persistants de l'application." Type="Path" Display="advanced" Required="true" Mask="false">/mnt/user/appdata/mergeron/state/logs</Config>
  <Config Name="Jeton backend" Target="/run/secrets/backend_token" Default="/mnt/user/appdata/mergeron/state/backend-token.txt" Mode="ro" Description="Secret partagé avec Nginx." Type="Path" Display="advanced" Required="true" Mask="true">/mnt/user/appdata/mergeron/state/backend-token.txt</Config>
  <Config Name="Clé OpenAI" Target="/run/secrets/openai_api_key" Default="/mnt/user/appdata/mergeron/state/openai-api-key.txt" Mode="ro" Description="Fichier contenant la clé API OpenAI." Type="Path" Display="advanced" Required="true" Mask="true">/mnt/user/appdata/mergeron/state/openai-api-key.txt</Config>
  <Config Name="Clés SSH" Target="/home/codex/.ssh" Default="/mnt/user/appdata/mergeron/state/ssh" Mode="ro" Description="Clés SSH dédiées montées en lecture seule." Type="Path" Display="advanced" Required="true" Mask="false">/mnt/user/appdata/mergeron/state/ssh</Config>
  <Config Name="Socket Mergeron Manager" Target="/run/mergeron-manager" Default="/mnt/user/appdata/mergeron/state/manager-run" Mode="rw" Description="Canal Unix local en lecture seule fonctionnelle entre l'application et Mergeron Manager. Ne contient aucune donnée métier." Type="Path" Display="advanced" Required="true" Mask="false">/mnt/user/appdata/mergeron/state/manager-run</Config>
  <Config Name="Script de démarrage" Target="/opt/codex/start-webui.sh" Default="/mnt/user/appdata/mergeron/config/start-webui.sh" Mode="ro" Description="Démarrage avec lecture du jeton depuis un fichier." Type="Path" Display="advanced" Required="true" Mask="false">/mnt/user/appdata/mergeron/config/start-webui.sh</Config>
  <Config Name="NODE_ENV" Target="NODE_ENV" Default="production" Mode="" Description="Mode Node.js." Type="Variable" Display="advanced" Required="true" Mask="false">production</Config>
  <Config Name="PORT" Target="PORT" Default="8172" Mode="" Description="Port interne du backend." Type="Variable" Display="advanced" Required="true" Mask="false">8172</Config>
  <Config Name="HOME" Target="HOME" Default="/home/codex" Mode="" Description="Dossier personnel interne." Type="Variable" Display="advanced" Required="true" Mask="false">/home/codex</Config>
  <Config Name="CODEX_HOME" Target="CODEX_HOME" Default="/home/codex/.codex" Mode="" Description="État Codex interne." Type="Variable" Display="advanced" Required="true" Mask="false">/home/codex/.codex</Config>
  <Config Name="WEBUI_DB_PATH" Target="WEBUI_DB_PATH" Default="/home/codex/.codex/codex-webui.sqlite" Mode="" Description="Base SQLite." Type="Variable" Display="advanced" Required="true" Mask="false">/home/codex/.codex/codex-webui.sqlite</Config>
  <Config Name="WEBUI_REQUIRE_IDENTITY" Target="WEBUI_REQUIRE_IDENTITY" Default="true" Mode="" Description="Exige l'identité transmise par Nginx." Type="Variable" Display="advanced" Required="true" Mask="false">true</Config>
  <Config Name="MERGERON_MANAGER_SOCKET" Target="MERGERON_MANAGER_SOCKET" Default="/run/mergeron-manager/manager.sock" Mode="" Description="Socket local utilisé pour consulter l'état de la pile." Type="Variable" Display="advanced" Required="true" Mask="false">/run/mergeron-manager/manager.sock</Config>
  <Config Name="URL publique Mergeron" Target="MERGERON_PUBLIC_URL" Default="https://mergeron.example.com" Mode="" Description="URL publique utilisée par les callbacks OAuth MCP et OnlyOffice. Elle doit correspondre à l'adresse WebUI du proxy inverse." Type="Variable" Display="always" Required="true" Mask="false">https://mergeron.example.com</Config>
  <Config Name="WEBUI_PROTECTED_PATHS" Target="WEBUI_PROTECTED_PATHS" Default="/home/codex,/run/secrets,/app,/proc,/sys,/dev,/etc,/root,/appdata/mergeron" Mode="" Description="Chemins protégés." Type="Variable" Display="advanced" Required="true" Mask="false">/home/codex,/run/secrets,/app,/proc,/sys,/dev,/etc,/root,/appdata/mergeron</Config>
  <Config Name="WORKSPACE_ROOTS" Target="WORKSPACE_ROOTS" Default="/workspaces,/appdata" Mode="" Description="Racines visibles dans le gestionnaire de fichiers." Type="Variable" Display="advanced" Required="true" Mask="false">/workspaces,/appdata</Config>
  <Config Name="LOG_LEVEL" Target="LOG_LEVEL" Default="info" Mode="" Description="Niveau des journaux." Type="Variable" Display="advanced" Required="true" Mask="false">info</Config>
  <Config Name="OPENAI_API_KEY_FILE" Target="OPENAI_API_KEY_FILE" Default="/run/secrets/openai_api_key" Mode="" Description="Chemin interne vers la clé OpenAI." Type="Variable" Display="advanced" Required="true" Mask="false">/run/secrets/openai_api_key</Config>
  <Config Name="OPENAI_CHAT_MODEL" Target="OPENAI_CHAT_MODEL" Default="gpt-5-mini" Mode="" Description="Modèle du chat simple." Type="Variable" Display="always" Required="true" Mask="false">gpt-5-mini</Config>
  <Config Name="HTTP_PROXY" Target="HTTP_PROXY" Default="http://mergeron-squid:3128" Mode="" Description="Proxy HTTP sortant." Type="Variable" Display="advanced" Required="true" Mask="false">http://mergeron-squid:3128</Config>
  <Config Name="HTTPS_PROXY" Target="HTTPS_PROXY" Default="http://mergeron-squid:3128" Mode="" Description="Proxy HTTPS sortant." Type="Variable" Display="advanced" Required="true" Mask="false">http://mergeron-squid:3128</Config>
  <Config Name="ALL_PROXY" Target="ALL_PROXY" Default="http://mergeron-squid:3128" Mode="" Description="Proxy générique sortant." Type="Variable" Display="advanced" Required="true" Mask="false">http://mergeron-squid:3128</Config>
  <Config Name="NO_PROXY" Target="NO_PROXY" Default="127.0.0.1,localhost,mergeron-ui" Mode="" Description="Destinations sans proxy." Type="Variable" Display="advanced" Required="true" Mask="false">127.0.0.1,localhost,mergeron-ui</Config>
  <Config Name="http_proxy" Target="http_proxy" Default="http://mergeron-squid:3128" Mode="" Description="Proxy HTTP pour les outils qui utilisent la variable en minuscules." Type="Variable" Display="advanced" Required="true" Mask="false">http://mergeron-squid:3128</Config>
  <Config Name="https_proxy" Target="https_proxy" Default="http://mergeron-squid:3128" Mode="" Description="Proxy HTTPS en minuscules." Type="Variable" Display="advanced" Required="true" Mask="false">http://mergeron-squid:3128</Config>
  <Config Name="all_proxy" Target="all_proxy" Default="http://mergeron-squid:3128" Mode="" Description="Proxy générique en minuscules." Type="Variable" Display="advanced" Required="true" Mask="false">http://mergeron-squid:3128</Config>
  <Config Name="no_proxy" Target="no_proxy" Default="127.0.0.1,localhost,mergeron-ui" Mode="" Description="Destinations sans proxy en minuscules." Type="Variable" Display="advanced" Required="true" Mask="false">127.0.0.1,localhost,mergeron-ui</Config>
  <Config Name="Fuseau horaire" Target="TZ" Default="Europe/Paris" Mode="" Description="Fuseau horaire du conteneur." Type="Variable" Display="always" Required="true" Mask="false">Europe/Paris</Config>
</Container>
