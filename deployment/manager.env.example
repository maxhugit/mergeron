# Copier hors du dépôt sous manager.env. Aucun secret dans cet exemple.
# Guide : docs/installation.md ; référence : docs/variables-manager.md.
# Vérifier chemins, réseau et domaine avant d’autoriser l’installation.
MERGERON_INSTALL_ENABLED=false
MERGERON_STACK_PREFIX=mergeron
MERGERON_STACK_ENVIRONMENT=production
MERGERON_STATE_ROOT=/srv/mergeron/state
MERGERON_APPDATA_ROOT=/srv/mergeron/state/appdata
MERGERON_PROXY_NETWORK=mergeron-proxy
MERGERON_ADMIN_SUBNET=172.30.44.0/28
MERGERON_WEBUI_URL=https://mergeron.example.com
MERGERON_AUTH_MODE=native
MERGERON_HOST_INTEGRATION=none

# Canal du guide courant ; choisir une version validée pour la production.
# L’image du Manager se choisit séparément dans la commande de lancement.
MERGERON_APP_IMAGE=ghcr.io/maxhugit/mergeron:edge
MERGERON_INGRESS_IMAGE=nginx:stable
MERGERON_EGRESS_IMAGE=ubuntu/squid:latest

# Services facultatifs, désactivés pour la première installation.
MERGERON_MANAGE_BROWSER=false
# Stop only after the last live browser reservation is released; no image pull on wake.
MERGERON_BROWSER_IDLE_SECONDS=300
MERGERON_BROWSER_STARTUP_SECONDS=90
MERGERON_PREVIEWS_ENABLED=false

# Optional temporary daily application-directory adapter (disabled by default).
# Enable here, restart Manager, then activate the daily catalog in Codex settings.
MERGERON_APP_CATALOG_BYPARR_ENABLED=false

# Optional, offline CPU file transcription worker. Starts only on a user request.
MERGERON_TRANSCRIPTION_ENABLED=false
MERGERON_TRANSCRIPTION_DIARIZATION=false
MERGERON_TRANSCRIPTION_IDLE_SECONDS=300
