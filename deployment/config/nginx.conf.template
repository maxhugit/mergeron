user nginx;
worker_processes 1;
pid /var/run/nginx.pid;

events { worker_connections 512; }

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    resolver 127.0.0.11 valid=10s ipv6=off;
    access_log /dev/stdout;
    error_log /dev/stderr warn;
    server_tokens off;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    server {
        listen 8080;
        client_max_body_size 100m;
        set $mergeron_backend http://mergeron-ui:8172;
        set $mergeron_oauth_callback http://mergeron-ui:12345;
        set $authentik_backend http://authentik:9000;

        # This endpoint is used only by Docker's local healthcheck. It cannot
        # be reached from another container or through Traefik.
        location = /_health {
            allow 127.0.0.1;
            deny all;
            proxy_pass $mergeron_backend/api/status;
            proxy_set_header Authorization "Bearer ${MERGERON_BACKEND_TOKEN}";
            proxy_set_header X-Webui-Auth-Source service;
            proxy_set_header X-Webui-Auth-Subject "";
            proxy_set_header X-Webui-Auth-Email "";
        }

        # Nginx is the single Authentik enforcement point. Keeping the check
        # here prevents another container on mergeron-proxy from bypassing the
        # public Traefik route.
        location = /_authentik_check {
            internal;
            proxy_pass $authentik_backend/outpost.goauthentik.io/auth/nginx;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-Method $request_method;
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header X-Original-URL https://$http_host$request_uri;
            proxy_set_header Cookie $http_cookie;
        }

        # Authentik's browser endpoints must remain reachable without first
        # passing the auth subrequest. They complete login, refresh the session
        # and return the browser to its original URL.
        location /outpost.goauthentik.io {
            proxy_pass $authentik_backend;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Original-URL https://$http_host$request_uri;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
        }

        location @goauthentik_proxy_signin {
            internal;
            add_header Set-Cookie $auth_cookie always;
            return 302 /outpost.goauthentik.io/start?rd=https://$http_host$request_uri;
        }

        # Public OAuth return endpoint used only while `codex mcp login` is
        # running. OAuth state validation is performed by Codex itself.
        location = /mcp/oauth/callback {
            proxy_pass $mergeron_oauth_callback;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_read_timeout 300s;
        }

        # OnlyOffice server-to-server download. Traefik routes this exact path
        # around interactive Authentik; the backend credential stays internal.
        location = /api/files/serve {
            proxy_pass $mergeron_backend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Authorization "Bearer ${MERGERON_BACKEND_TOKEN}";
            proxy_set_header X-Webui-Auth-Source document;
            proxy_set_header X-Webui-Auth-Subject "";
            proxy_set_header X-Webui-Auth-Email "";
            proxy_buffering off;
            proxy_read_timeout 300s;
        }

        # OnlyOffice save callback. Codex additionally verifies the signed
        # state and OnlyOffice JWT before accepting a write.
        location = /api/onlyoffice/callback {
            proxy_pass $mergeron_backend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Authorization "Bearer ${MERGERON_BACKEND_TOKEN}";
            proxy_set_header X-Webui-Auth-Source service;
            proxy_set_header X-Webui-Auth-Subject "";
            proxy_set_header X-Webui-Auth-Email "";
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_read_timeout 300s;
        }

        location / {
            auth_request /_authentik_check;
            auth_request_set $identity_uid $upstream_http_x_authentik_uid;
            auth_request_set $identity_email $upstream_http_x_authentik_email;
            auth_request_set $auth_cookie $upstream_http_set_cookie;
            add_header Set-Cookie $auth_cookie always;
            error_page 401 = @goauthentik_proxy_signin;
            proxy_pass $mergeron_backend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            # The application token remains server-side and replaces any
            # Authorization header supplied by the client.
            proxy_set_header Authorization "Bearer ${MERGERON_BACKEND_TOKEN}";
            proxy_set_header X-Webui-Auth-Source authentik;
            proxy_set_header X-Webui-Auth-Subject $identity_uid;
            proxy_set_header X-Webui-Auth-Email $identity_email;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }
    }
}
